# Database
DATABASE_USER=ifesdoc_user
DATABASE_PASSWORD=ifesdoc_pass
DATABASE_HOST=localhost
DATABASE_PORT=55433
DATABASE_URL=postgresql://ifesdoc_user:ifesdoc_pass@localhost:55433/ifesdoc

# Docker host ports
IFESDOC_POSTGRES_PORT=55433
IFESDOC_SONAR_POSTGRES_PORT=55434

# Security
SECRET_KEY=replace_with_random_secret_at_least_32_chars
INITIAL_ADMIN_PASSWORD=replace_with_strong_initial_admin_password
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_IDLE_EXPIRE_MINUTES=30
BACKEND_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# Environment
ENVIRONMENT=development

# Frontend
VITE_APP_NAME=IFESDOC
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK_API=true

# Bot conversacional
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
BOT_ENABLE_TELEGRAM=false
BOT_ENABLE_WHATSAPP=false
BOT_PUBLIC_MODE=true
BOT_RATE_LIMIT_PER_MINUTE=20

# OCR
OCR_ENABLED=true
OCR_LANGUAGE=por
OCR_DPI=200
OCR_MAX_PAGES=20
OCR_MIN_TEXT_LENGTH=50
OCR_TIMEOUT_SECONDS=120

# SonarQube
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=change_this_token
